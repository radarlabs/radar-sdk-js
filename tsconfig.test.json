{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "node",
    "noUnusedLocals": false,
    "resolveJsonModule": true,
    "baseUrl": ".",
    // mirrors the jest moduleNameMapper so plugin sources typecheck without a build
    "paths": {
      "radar-sdk-js": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
